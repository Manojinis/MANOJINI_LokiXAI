# LokiXAI Configuration Environment Template
# Copy this file to .env and configure your desired settings.

# Primary AI Provider ("openai", "local", "mock")
LOKIXAI_AI_PROVIDER=openai

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=45

# Local Provider Settings (e.g., Ollama or vLLM)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.2
LOCAL_AI_API_KEY=ollama

# Security & Permissions
# Auto-approve low-risk read-only tools ("true" / "false")
LOKIXAI_AUTO_APPROVE_SAFE_TOOLS=true
# Require explicit popup confirmation for destructive actions
LOKIXAI_REQUIRE_CONFIRMATION_DESTRUCTIVE=true
# Approved workspace directories (semicolon separated)
LOKIXAI_APPROVED_DIRECTORIES=D:\MANOJINI_LokiXAI;C:\Users\Public

# Voice & Speech
LOKIXAI_TTS_ENABLED=true
LOKIXAI_TTS_RATE=175
LOKIXAI_TTS_VOLUME=1.0

# System Monitoring
LOKIXAI_MONITOR_REFRESH_INTERVAL_SEC=2.0

# Storage & Logging
LOKIXAI_DATA_DIR=data
LOKIXAI_LOG_LEVEL=INFO
